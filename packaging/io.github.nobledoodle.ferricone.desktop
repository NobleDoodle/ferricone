[Desktop Entry]
Type=Application
Name=Ferricone Player
GenericName=Media Player
Comment=Play videos, music and streams, with a library beside the player
Exec=ferricone %U
Icon=io.github.nobledoodle.ferricone
Terminal=false
Categories=AudioVideo;Player;Video;Audio;
Keywords=video;movie;music;audio;player;vlc;stream;subtitles;
StartupWMClass=ferricone
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/ogg;video/x-flv;video/x-ms-wmv;video/3gpp;video/mp2t;audio/mpeg;audio/flac;audio/ogg;audio/x-wav;audio/mp4;audio/aac;audio/opus;audio/x-matroska;audio/x-mpegurl;application/vnd.apple.mpegurl;x-scheme-handler/rtsp;x-scheme-handler/mms;
