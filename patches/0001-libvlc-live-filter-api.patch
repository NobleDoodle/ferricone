+int libvlc_media_player_set_filter( libvlc_media_player_t *p_mi,
+                                    const char *psz_name, bool b_enable )
+{
+    module_t *module = module_find( psz_name );
+    const char *var;
+
+    if( module == NULL )
+        var = NULL;
+    else if( module_provides( module, "audio filter" ) )
+        var = "audio-filter";
+    else if( module_provides( module, "video filter" ) )
+        var = "video-filter";
+    else if( module_provides( module, "sub source" ) )
+        var = "sub-source";
+    else if( module_provides( module, "sub filter" ) )
+        var = "sub-filter";
+    else
+        var = NULL;
+    if( var == NULL )
+    {
+        libvlc_printerr( "No filter module named \"%s\"", psz_name );
+        return -1;
+    }
+
+    /* The player's chain is what outputs created later start with. */
+    char *chain = player_filter_toggle( p_mi, var, psz_name, b_enable );
+    if( chain == NULL )
+        return -1;
+
+    if( strcmp( var, "audio-filter" ) == 0 )
+        vlc_player_aout_EnableFilter( p_mi->player, psz_name, b_enable );
+    else
+    {
+        size_t count;
+        vout_thread_t **vouts = vlc_player_vout_HoldAll( p_mi->player, &count );
+        for( size_t i = 0; i < count; i++ )
+        {
+            var_SetString( vouts[i], var, chain );
+            vout_Release( vouts[i] );
+        }
+        free( vouts );
+    }
+    free( chain );
+    return 0;
+}
+
+int libvlc_media_player_set_filter_option( libvlc_media_player_t *p_mi,
+                                           const char *psz_option,
+                                           const char *psz_value )
+{
+    int type = config_GetType( psz_option );
+    vlc_value_t val;
+    char *end = NULL;
+
+    switch( type )
+    {
+        case VLC_VAR_BOOL:
+            if( !strcmp( psz_value, "1" ) || !strcasecmp( psz_value, "true" ) )
+                val.b_bool = true;
+            else if( !strcmp( psz_value, "0" ) || !strcasecmp( psz_value, "false" ) )
+                val.b_bool = false;
+            else
+                goto invalid;
+            break;
+        case VLC_VAR_INTEGER:
+            val.i_int = strtoll( psz_value, &end, 0 );
+            break;
+        case VLC_VAR_FLOAT:
+            val.f_float = vlc_strtof_c( psz_value, &end );
+            break;
+        case VLC_VAR_STRING:
+            val.psz_string = (char *)psz_value;
+            break;
+        default:
+            libvlc_printerr( "Unknown option \"%s\"", psz_option );
+            return -1;
+    }
+    if( end != NULL && ( end == psz_value || *end != '\0' ) )
+        goto invalid;
+
+    /* Filters created later inherit the value from the player. */
+    if( var_Type( p_mi, psz_option ) == 0 )
+        var_Create( p_mi, psz_option, type );
+    var_SetChecked( p_mi, psz_option, type, val );
+
+    /* Running filters listen on their output's variables. */
+    size_t count;
+    vout_thread_t **vouts = vlc_player_vout_HoldAll( p_mi->player, &count );
+    for( size_t i = 0; i < count; i++ )
+    {
+        if( var_Type( vouts[i], psz_option ) != 0 )
+            var_SetChecked( vouts[i], psz_option, type, val );
+        vout_Release( vouts[i] );
+    }
+    free( vouts );
+
+    audio_output_t *aout = vlc_player_aout_Hold( p_mi->player );
+    if( aout != NULL )
+    {
+        if( var_Type( aout, psz_option ) != 0 )
+            var_SetChecked( aout, psz_option, type, val );
+        aout_Release( aout );
+    }
+    return 0;
+
+invalid:
+    libvlc_printerr( "Invalid value \"%s\" for option \"%s\"", psz_value, psz_option );
+    return -1;
+}
 
