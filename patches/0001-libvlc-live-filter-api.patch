 #define EQZ_BAND_VALUE_SIZE 12
 
+/* Returns `chain` (a ':'-separated module list) with `name` added or removed,
+ * matching whole module names; NULL on allocation failure. */
+static char *filter_chain_toggle( const char *chain, const char *name, bool add )
+{
+    struct vlc_memstream ms;
+    const size_t name_len = strlen( name );
+    bool present = false;
+
+    vlc_memstream_open( &ms );
+    for( const char *p = chain ? chain : ""; *p != '\0'; )
+    {
+        size_t len = strcspn( p, ":" );
+        /* An entry may carry options: "module{key=value}" */
+        size_t module_len = strcspn( p, ":{" );
+        bool match = module_len == name_len && strncmp( p, name, name_len ) == 0;
+
+        present |= match;
+        if( len > 0 && !( match && !add ) )
+            vlc_memstream_printf( &ms, "%s%.*s", ms.length ? ":" : "",
+                                  (int)len, p );
+        p += len;
+        if( *p == ':' )
+            p++;
+    }
+    if( add && !present )
+        vlc_memstream_printf( &ms, "%s%s", ms.length ? ":" : "", name );
+    return vlc_memstream_close( &ms ) == 0 ? ms.ptr : NULL;
+}
+
+/* Adds or removes `name` in the player's `var` chain and returns the result. */
+static char *player_filter_toggle( libvlc_media_player_t *p_mi,
+                                   const char *var, const char *name, bool add )
+{
+    if( var_Type( p_mi, var ) == 0 )
+        var_Create( p_mi, var, VLC_VAR_STRING | VLC_VAR_DOINHERIT );
+
+    char *old = var_GetString( p_mi, var );
+    char *chain = filter_chain_toggle( old, name, add );
+    free( old );
+    if( chain != NULL )
+        var_SetString( p_mi, var, chain );
+    return chain;
+}
