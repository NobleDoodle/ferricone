 LIBVLC_API int libvlc_media_player_set_equalizer( libvlc_media_player_t *p_mi, libvlc_equalizer_t *p_equalizer );
 
+/**
+ * Enable or disable a filter module while the player runs.
+ *
+ * Video filters, subpicture sources and filters, and audio filters are all
+ * accepted, as in the effects dialogs of VLC's own interface. Running
+ * outputs change immediately, and outputs created later start with the
+ * player's filter chain. Other enabled filters, including the equalizer,
+ * are kept.
+ *
+ * \param p_mi the media player
+ * \param psz_name the filter module, for example "sepia" or "compressor"
+ * \param b_enable true to add the filter, false to remove it
+ * \return 0 on success (also if the filter already was in that state),
+ *         -1 if no filter module has that name
+ * \version LibVLC 4.0.0 or later
+ */
+LIBVLC_API int libvlc_media_player_set_filter( libvlc_media_player_t *p_mi,
+                                               const char *psz_name,
+                                               bool b_enable );
+
+/**
+ * Set an option of a filter module, such as "sepia-intensity" or
+ * "compressor-ratio".
+ *
+ * The value is parsed according to the option's type: an integer, a float
+ * (with a '.' decimal separator), a boolean ("0", "1", "false", "true") or a
+ * string. Running filters pick the value up immediately where the module
+ * supports it, and filters enabled later start with it.
+ *
+ * \param p_mi the media player
+ * \param psz_option the option name, as in VLC's command line without "--"
+ * \param psz_value the new value
+ * \return 0 on success, -1 if the option is unknown or the value invalid
+ * \version LibVLC 4.0.0 or later
+ */
+LIBVLC_API int libvlc_media_player_set_filter_option( libvlc_media_player_t *p_mi,
+                                                      const char *psz_option,
+                                                      const char *psz_value );
+
