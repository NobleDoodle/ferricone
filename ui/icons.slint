    out property <IconLayers> view-active: { accent: @image-url("icons/view-active.accent.svg"), fg: @image-url("icons/view-active.fg.svg") };
    out property <IconLayers> volume-high: { fg: @image-url("icons/volume-high.fg.svg") };
    out property <IconLayers> waveform-two-tone: { dim: @image-url("icons/waveform-two-tone.dim.svg"), fg: @image-url("icons/waveform-two-tone.fg.svg") };
    out property <IconLayers> window: { fg: @image-url("icons/window.fg.svg") };
    out property <IconLayers> window-two-tone: { dim: @image-url("icons/window-two-tone.dim.svg"), fg: @image-url("icons/window-two-tone.fg.svg") };
    out property <IconLayers> wrench: { fg: @image-url("icons/wrench.fg.svg") };
    out property <IconLayers> zoom: { fg: @image-url("icons/zoom.fg.svg") };
}
